+    // Temporary assumptions stay in this attempt. Only a source model leaves it.
+    bool try_boundary_repair(const F& accepted,const toolbox::Model& seed,Time until){
+        if(seed.size()!=size_t(original.n+1)||Clock::now()>=until)return false;
+        const C* guard=nullptr;
+        for(const C& clause:accepted){
+            if(clause.empty()||std::any_of(clause.begin(),clause.end(),
+                    [&](int l){return toolbox::value(seed,l)==1;}))continue;
+            if(!guard||clause.size()<guard->size())guard=&clause;
+        }
+        if(!guard){
+            std::fprintf(stderr,"IMMEDIATE skip=no_violated_guard\n");
+            return false;
+        }
+        auto violations=[&](const toolbox::Model& candidate){
+            return std::count_if(original.cs.begin(),original.cs.end(),[&](const C& c){
+                return std::none_of(c.begin(),c.end(),[&](int l){return toolbox::value(candidate,l)==1;});
+            });
+        };
+        // Prefer the single guard flip which leaves fewest original clauses false.
+        vector<pair<int,int>> pivots;
+        toolbox::Model probe=seed;
+        for(int l:*guard){
+            if(Clock::now()>=until)return false;
+            probe[abs(l)]^=1;
+            pivots.emplace_back(violations(probe),l);
+            probe[abs(l)]^=1;
+        }
+        sort(pivots.begin(),pivots.end());
+        F without_guard;
+        for(const C& clause:all)if(clause!=*guard)without_guard.push_back(clause);
+        toolbox::AdaptivePropagator before(original.n,without_guard),after(original.n,all);
+        const int initial=violations(seed);
+        int tried=0;
+        for(auto [score,pivot]:pivots){
+            (void)score;
+            if(++tried>4||Clock::now()>=until)break;
+            C assumptions;
+            for(int l:*guard)if(l!=pivot)assumptions.push_back(-l);
+            bool consistent_before=before.consistent(assumptions);
+            if(!after.consistent(assumptions)){
+                std::fprintf(stderr,"IMMEDIATE branch_conflict=1 guard_added_conflict=%d\n",consistent_before);
+                continue;
+            }
+            if(!consistent_before||toolbox::value(after.state,pivot)!=1)
+                throw std::logic_error("invalid conditional boundary propagation");
+            const int extra_units=int(after.trail.size())-int(before.trail.size());
+            toolbox::Model candidate=seed;
+            for(int l:after.trail)candidate[abs(l)]=l>0;
+            const auto saved_progress=live_repair;
+            bool solved=toolbox::satisfied(original.cs,candidate);
+            if(!solved&&Clock::now()<until)
+                solved=repair_feedback(original.n,original.cs,candidate,after.state,until);
+            live_repair=saved_progress; // preserve later controller decisions
+            int final_bad=violations(candidate);
+            bool accepted_model=solved&&model(candidate,"boundary_immediate_source_model");
+            std::fprintf(stderr,"IMMEDIATE attempt=1 width=%zu initial_bad=%d final_bad=%d extra_units=%d model=%d\n",
+                         guard->size(),initial,final_bad,extra_units,accepted_model);
+            return accepted_model;
+        }
+        std::fprintf(stderr,"IMMEDIATE skip=no_admissible_pivot\n");
+        return false;
+    }
